# Chuỗi kết nối Neon Postgres (dùng bản "pooled"). Để trống khi chạy local để dùng database nhúng trong ./.pglite
DATABASE_URL=

# Chuỗi bí mật ký phiên đăng nhập. Tạo bằng: openssl rand -base64 32
SESSION_SECRET=

# Tài khoản nhận tiền nạp, dùng để tạo mã VietQR ở trang Nạp tiền.
# BANK_ID: tên viết tắt ngân hàng theo VietQR (VD: MB, VCB, TCB, ACB, VPB) hoặc mã BIN 6 số.
BANK_ID=
BANK_NAME=
BANK_ACCOUNT_NO=
BANK_ACCOUNT_NAME=

# Kho ảnh (menu món ăn trong ngày và avatar). Để trống khi chạy local: ảnh lưu trong public/uploads.
# Khi deploy, tạo Blob store trên Vercel rồi dán token vào. Không cần sửa code.
BLOB_READ_WRITE_TOKEN=
